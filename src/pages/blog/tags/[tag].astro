---
import type { GetStaticPaths } from "astro";
import PostList from "../../../components/PostList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPosts, tagSlug, type Post } from "../../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const byTag = new Map<string, { label: string; posts: Post[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      const group = byTag.get(slug) ?? { label: tag, posts: [] };
      group.posts.push(post);
      byTag.set(slug, group);
    }
  }
  return [...byTag].map(([tag, { label, posts }]) => ({
    params: { tag },
    props: { label, posts },
  }));
}) satisfies GetStaticPaths;

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged #${label}`} description={`Technical articles about ${label}.`}>
  <h1>Posts tagged #{label}</h1>
  <PostList posts={posts} />
  <p>
    <a href="/blog/">← All posts</a>
  </p>
</BaseLayout>
