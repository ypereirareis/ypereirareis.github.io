---
import { SITE } from "../site.config";
import "../styles/global.css";

export interface Props {
  title?: string | undefined;
  description?: string | undefined;
  type?: "website" | "article";
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  jsonLd?: Record<string, unknown>[];
  /** Append the job title to the page title (SEO), e.g. on the CV. */
  withJobTitle?: boolean;
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedTime,
  modifiedTime,
  jsonLd = [],
  withJobTitle = false,
} = Astro.props;

// Home and CV carry the job title for SEO; posts use their own title only.
const fullTitle = !title
  ? `${SITE.jobTitle} · ${SITE.author}`
  : type === "article"
    ? title
    : withJobTitle
      ? `${title} · ${SITE.author}, ${SITE.jobTitle}`
      : `${title} · ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

<meta name="color-scheme" content="light dark" />
<script is:inline>
  // Apply the theme chosen with the header toggle before the first paint.
  try {
    const theme = localStorage.getItem("theme");
    if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
  } catch {
    // Storage unavailable: keep the system theme.
  }
</script>
<meta name="theme-color" content="#4338ca" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#312e81" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.title} · Posts`}
  href={new URL("/rss.xml", Astro.site)}
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.title} · ${SITE.jobTitle}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd.map((data) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
))}
