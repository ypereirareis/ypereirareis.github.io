---
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, tagSlug } from "../../lib/posts";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Blog"
  description="Technical articles about platform engineering, CI/CD, Kubernetes, observability and developer experience."
>
  <h1>Blog</h1>
  {tags.length > 0 && (
    <nav aria-label="Tags" class="tags">
      <ul>
        {tags.map((tag) => (
          <li>
            <a href={`/blog/tags/${tagSlug(tag)}/`}>#{tag}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <PostList posts={posts} />
</BaseLayout>

<style>
  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }
</style>
