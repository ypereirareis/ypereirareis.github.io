---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Topics from "../../components/Topics.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumbJsonLd } from "../../lib/jsonld";
import { getPosts, postUrl, type Post } from "../../lib/posts";
import { SITE } from "../../site.config";

export const getStaticPaths = (async () => {
  // Posts are sorted newest first: the previous post is the older one, the next post the newer one.
  // Neighbors are taken among published posts only: drafts (visible in dev) never appear in the pager.
  const posts = await getPosts();
  const published = posts.filter((post) => !post.data.draft);
  return posts.map((post) => {
    const index = post.data.draft ? -1 : published.indexOf(post);
    return {
      params: { slug: post.id },
      props: {
        post,
        previous: index >= 0 ? published[index + 1] : undefined,
        next: index > 0 ? published[index - 1] : undefined,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous?: Post | undefined;
  next?: Post | undefined;
}

const { post, previous, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);

const site = Astro.site ?? new URL(Astro.url.origin);
const ogImage = `/og/${post.id}.png`;
const url = new URL(postUrl(post), site).href;
const OUTDATED_AFTER_YEARS = 3;
const lastUpdate = updatedDate ?? pubDate;
const isOutdated = new Date().getFullYear() - lastUpdate.getFullYear() >= OUTDATED_AFTER_YEARS;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  url,
  mainEntityOfPage: url,
  inLanguage: SITE.lang,
  keywords: tags,
  image: new URL(ogImage, site).href,
  author: { "@id": new URL("/#person", site).href, "@type": "Person", name: SITE.author },
};
const breadcrumb = breadcrumbJsonLd(site, [
  { name: "Home", path: "/" },
  { name: "Posts", path: "/posts/" },
  { name: title, path: postUrl(post) },
]);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={[articleJsonLd, breadcrumb]}
  image={ogImage}
  imageAlt={title}
  tags={tags}
>
  <article class="post">
    <header class="post-header">
      <p class="meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <>
            {" · Updated "}
            <FormattedDate date={updatedDate} />
          </>
        )}
      </p>
      <h1>{title}</h1>
      <Topics topics={tags} />
    </header>
    {isOutdated && (
      <p class="outdated" role="note">
        This article was written in {pubDate.getFullYear()}. Tools and versions have moved on since
        then, so some content may be outdated.
      </p>
    )}
    <div class="prose">
      <Content />
    </div>
    {(previous || next) && (
      <nav class="pager" aria-label="Previous and next posts">
        {previous && (
          <a class="pager-link previous" href={postUrl(previous)} rel="prev">
            <span class="pager-label">← Previous post</span>
            <span class="pager-title">{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="pager-link next" href={postUrl(next)} rel="next">
            <span class="pager-label">Next post →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
    <p class="back">
      <a href="/posts/">← All posts</a>
    </p>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .post-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    margin: 0 0 0.5rem;
    color: var(--primary);
    font-weight: 600;
  }

  .prose {
    margin-top: 2rem;
  }

  .outdated {
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--accent);
    background: var(--hue-amber-bg);
    color: var(--hue-amber-fg);
    font-size: 0.95rem;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--text);
    text-decoration: none;
  }

  .pager-link.next {
    grid-column: 2;
    text-align: right;
  }

  .pager-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .pager-title {
    color: var(--primary);
    font-weight: 500;
  }

  .pager-link:hover .pager-title {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-link.next {
      grid-column: 1;
      text-align: left;
    }
  }

  .back {
    margin-top: 3rem;
  }
</style>
