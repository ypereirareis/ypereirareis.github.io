---
import BaseHead, { type Props as HeadProps } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../site.config";

export type Props = HeadProps & {
  /** Limit the page content to the reading width, like a post. */
  narrow?: boolean;
};

const { narrow = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={["container", { narrow }]} tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
