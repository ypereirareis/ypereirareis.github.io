---
import type { Hue } from "../site.config";

export interface Props {
  label: string;
  href?: string | undefined;
  hue: Hue;
}

const { label, href, hue } = Astro.props;
const Element = href ? "a" : "span";
---

<Element class="chip" data-hue={hue} href={href}>
  <slot>{label}</slot>
</Element>
