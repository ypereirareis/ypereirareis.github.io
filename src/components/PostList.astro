---
import { postUrl, type Post } from "../lib/posts";
import FormattedDate from "./FormattedDate.astro";

export interface Props {
  posts: Post[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

{posts.length === 0 ? (
  <p>No posts yet.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <Heading class="post-title">
          <a href={postUrl(post)}>{post.data.title}</a>
        </Heading>
        <p class="post-meta">
          <FormattedDate date={post.data.pubDate} />
        </p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .post-list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-title {
    margin: 0;
    font-size: 1.25rem;
  }

  .post-meta {
    margin: 0.25rem 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  li > p:last-child {
    margin: 0;
  }
</style>
