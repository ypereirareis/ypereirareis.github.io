---
import PostIndex from "../components/PostIndex.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { personJsonLd } from "../lib/jsonld";
import { getPosts, HOME_POSTS } from "../lib/posts";
import { FOCUS_AREAS, INTRO_POINTS, SITE } from "../site.config";

const site = Astro.site ?? new URL(Astro.url.origin);
const recentPosts = (await getPosts()).slice(0, HOME_POSTS);
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: site.href,
  inLanguage: SITE.lang,
  author: { "@id": new URL("/#person", site).href },
};
---

<BaseLayout narrow jsonLd={[personJsonLd(site), websiteJsonLd]}>
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <h1 id="intro-title" class="page-title">
        <span class="role">{SITE.jobTitle}</span>
        <span class="name">{SITE.author}</span>
      </h1>
      <ul class="lead">
        {INTRO_POINTS.map((point) => (
          <li>
            {point.split("**").map((part, index) => (index % 2 ? <strong>{part}</strong> : part))}
          </li>
        ))}
      </ul>
      <p class="actions">
        <a class="button" href="/cv/">
          View my CV
        </a>
        <a class="button secondary" href="/posts/">
          Read my posts
        </a>
      </p>
      <ul class="social">
        <li>
          <a href={SITE.links.github} rel="me">
            <Icon name="github" />
            GitHub
          </a>
        </li>
        <li>
          <a href={SITE.links.linkedin} rel="me">
            <Icon name="linkedin" />
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section aria-labelledby="focus">
    <h2 id="focus" class="section-title">
      What I do or did
    </h2>
    <div class="focus-list">
      {FOCUS_AREAS.map(({ title, text, hue, items }) => (
        <section class="focus" data-hue={hue}>
          <h3>
            <span class="swatch" aria-hidden="true"></span>
            {title}
          </h3>
          <p class="muted">{text}</p>
          <ul class="points">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section aria-labelledby="recent-posts">
    <h2 id="recent-posts" class="section-title">
      Recent posts
    </h2>
    {recentPosts.length === 0 ? (
      <p class="muted">No posts yet.</p>
    ) : (
      <PostIndex posts={recentPosts} />
    )}
    <p class="all-posts">
      <a href="/posts/">All posts →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-bottom: 1rem;
  }

  h1 {
    margin: 0;
  }

  .lead {
    max-width: 40rem;
    margin: 1.25rem 0 1.5rem;
    padding-left: 1.2rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    list-style: disc;
  }

  .lead li + li {
    margin-top: 0.3rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-weight: 500;
    text-decoration: none;
  }

  .social a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .focus-list {
    display: grid;
    gap: 2.25rem;
  }

  .focus h3 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }

  .swatch {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--hue-solid);
  }

  .focus .muted {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }

  .points {
    margin: 0;
    padding-left: 1.2rem;
    list-style: disc;
  }

  .points li + li {
    margin-top: 0.35rem;
  }

  .all-posts {
    margin: 1rem 0 0;
  }
</style>
